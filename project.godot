; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Roll the ball"
config/description="Get the ball in the basket. That is all. For real. Can you do it?"
config/version="0.1"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

SilentWolf="*res://addons/silent_wolf/SilentWolf.gd"
SignalBus="*res://globals/SignalBus.gd"
GameManager="*res://globals/GameManager.gd"
SaveManager="*res://globals/SaveManager.gd"
LeaderboardApi="*res://globals/LeaderboardAPI.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
